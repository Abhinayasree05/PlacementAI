// firestore.rules.example
// Copy this into Firebase Console -> Firestore Database -> Rules,
// or into a firestore.rules file deployed via the Firebase CLI.
//
// Model: each student can read/write only their own profile document
// at /users/{uid}. No client can read another student's data directly
// (build an admin Cloud Function with the Admin SDK for staff-facing
// aggregate views instead of loosening these rules).

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // handle account deletion via a Cloud Function instead
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
